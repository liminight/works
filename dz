#include <iostream>
#include <new>

void freeMatrix(int **a, int rows)
{
    if (!a)
        return;

    for (int i = 0; i < rows; ++i)
    {
        delete[] a[i];
    }
    delete[] a;
}

int main()
{
    int lines, columns;

    if (!(std::cin >> lines >> columns) || lines <= 0 || columns <= 0)
    {
        return 1;
    }
}